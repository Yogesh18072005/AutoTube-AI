# Copy this file to .env. Keep .env private and never commit it.

# Frontend / API
CORS_ORIGINS=http://localhost:3000
AUTOTUBE_MEDIA_DIR=/app/media
AUTOTUBE_DB_PATH=/app/data/autotube.db
REDIS_URL=redis://localhost:6379/0

# OpenAI-compatible text and image generation (server-side only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# ElevenLabs voice generation (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Google Cloud project: enable YouTube Data API v3 and YouTube Analytics API.
# Add this exact callback URL to the OAuth client as an authorized redirect URI.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
YOUTUBE_DATA_API_KEY=

# Generate both secrets locally; never reuse a public example value.
# AUTOTUBE_SECRET_KEY signs OAuth state.
# AUTOTUBE_TOKEN_ENCRYPTION_KEY must be a Fernet key.
AUTOTUBE_SECRET_KEY=
AUTOTUBE_TOKEN_ENCRYPTION_KEY=

# Optional Java migration API (Docker Compose profile: java-migration)
DATABASE_PASSWORD=change_this_local_password
DATABASE_URL=jdbc:postgresql://localhost:5432/autotube
DATABASE_USERNAME=autotube
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
